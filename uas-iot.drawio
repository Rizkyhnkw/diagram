        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: { &#39;primaryColor&#39;: &#39;#e1f5fe&#39;, &#39;edgeLabelBackground&#39;:&#39;#ffffff&#39;, &#39;tertiaryColor&#39;: &#39;#fff&#39;}}}%%\n\ngraph TD\n    %% --- LAYER EDGE ---\n    subgraph EDGE [\&quot;&amp;nbsp;&amp;nbsp;LAYER PERSEPSI (Sensor Node di Hutan)&amp;nbsp;&amp;nbsp;\&quot;]\n        direction TB\n        Bat[\&quot;Baterai Lithium 3.7V&lt;br&gt;(2000mAh)\&quot;]\n        Gate[\&quot;MOSFET&lt;br&gt;(Sensor Power Gating)\&quot;]\n        MCU{{\&quot;Mikrokontroler&lt;br&gt;(Deep Sleep Logic)\&quot;}}\n        Sensors[\&quot;Sensor Suhu, Kelembapan,&lt;br&gt;dan Gas CO2\&quot;]\n    end\n\n    %% --- LAYER JARINGAN ---\n    subgraph NETWORK [\&quot;&amp;nbsp;&amp;nbsp;LAYER JARINGAN (Konektivitas Hemat Daya)&amp;nbsp;&amp;nbsp;\&quot;]\n        direction TB\n        LoRa[\&quot;Modul LoRa RF\&quot;]\n        Gateway((\&quot;Gateway LoRaWAN&lt;br&gt;(Jarak Jauh)\&quot;))\n    end\n\n    %% --- LAYER CLOUD ---\n    subgraph CLOUD [\&quot;&amp;nbsp;&amp;nbsp;LAYER PEMROSESAN (Backend &amp; Data Engineering)&amp;nbsp;&amp;nbsp;\&quot;]\n        direction TB\n        Broker[\&quot;MQTT / Network Server\&quot;]\n        ETL[\&quot;Incremental ETL Pipeline&lt;br&gt;(Transformasi Data Berkala)\&quot;]\n        DWH[(\&quot;Data Warehouse&lt;br&gt;(Penyimpanan &amp; Analisis Historis)\&quot;)]\n    end\n\n    %% --- LAYER APLIKASI ---\n    subgraph APP [\&quot;&amp;nbsp;&amp;nbsp;LAYER APLIKASI (End-User)&amp;nbsp;&amp;nbsp;\&quot;]\n        direction TB\n        Dashboard[\&quot;Dashboard Monitoring&lt;br&gt;(Status Harian)\&quot;]\n        Alert[\&quot;Notifikasi Darurat&lt;br&gt;(Telegram / Alarm)\&quot;]\n    end\n\n    %% --- ALIRAN KELISTRIKAN (Merah) ---\n    Bat -.-&gt;|Daya Utama| MCU\n    Bat -.-&gt;|Arus Terputus/Tersambung| Gate\n    MCU -.-&gt;|Kontrol Sakelar (Wake-up)| Gate\n    Gate -.-&gt;|Distribusi Daya| Sensors\n    MCU -.-&gt;|Daya Transmisi| LoRa\n\n    %% --- ALIRAN DATA (Biru) ---\n    Sensors --&gt;|Data Mentah Lokal| MCU\n    MCU --&gt;|Threshold Alert / Daily Heartbeat| LoRa\n    LoRa ===&gt;|Gelombang Radio 923MHz| Gateway\n    Gateway --&gt;|TCP/IP / Internet| Broker\n    \n    Broker --&gt;|Data Log| ETL\n    ETL --&gt;|Data Bersih| DWH\n    DWH --&gt;|Visualisasi Tren| Dashboard\n    Broker ===&gt;|Trigger Kondisi Kritis!| Alert\n\n    %% --- STYLING ---\n    classDef section fill:#f8f9fa,stroke:#343a40,stroke-width:2px,stroke-dasharray: 5 5,color:#212529,font-weight:bold;\n    classDef power fill:#ffebee,stroke:#c62828,stroke-width:1px;\n    classDef hardware fill:#fff3e0,stroke:#ef6c00,stroke-width:2px,font-weight:bold;\n    classDef data fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;\n    \n    class EDGE,NETWORK,CLOUD,APP section;\n    class Bat,Gate power;\n    class MCU hardware;\n    class Broker,ETL,DWH,Dashboard data;\n    \n    linkStyle 0,1,2,3,4 stroke:#d32f2f,stroke-width:2px,stroke-dasharray: 5 5;\n    linkStyle 5,6,8,9,10,11 stroke:#1565c0,stroke-width:2px;\n    linkStyle 7,12 stroke:#d84315,stroke-width:4px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="glaDudDaKFRBNdRRU16s-1">
